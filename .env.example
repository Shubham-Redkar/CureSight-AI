# CureSight AI — Root Environment Configuration Template

# Database Configuration
POSTGRES_USER=curesight
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL="postgresql://curesight:CHANGE_ME@localhost:5432/curesight?sslmode=disable"

# Backend Configuration (backend/.env)
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
FRONTEND_URL=http://localhost:5173
FASTAPI_URL=http://localhost:8000

# Frontend Configuration (frontend/.env.production / frontend/.env.development)
# Production: VITE_API_URL=https://curesight-ai.onrender.com/api
# Development: VITE_API_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000
